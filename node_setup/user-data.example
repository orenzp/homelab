#cloud-config
ssh_pwauth: false # Security: Disable password login, use SSH keys only
users:
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    shell: /bin/bash
    ssh_authorized_keys:
      - ssh-rsa AAAAB3Nza... # REPLACE WITH YOUR KEY

hostname: k8s-node-xx
manage_etc_hosts: true

# 1. Install K3s and Longhorn dependencies
package_update: true
packages:
  - curl
  - vim
  - git
  - open-iscsi  # Required for Longhorn
  - nfs-common  # Required for Longhorn
  - iptables

# 2. Pre-configure Kernel Modules and Sysctl
write_files:
  - path: /etc/modules-load.d/k3s.conf
    content: |
      overlay
      br_netfilter
  - path: /etc/sysctl.d/k3s.conf
    content: |
      net.bridge.bridge-nf-call-iptables = 1
      net.ipv4.ip_forward = 1
      net.bridge.bridge-nf-call-ip6tables = 1

# 3. Finalize Node Optimization
runcmd:
  # Enable cgroups for RPi (crucial for K3s memory management)
  - sed -i 's/$/ cgroup_enable=cpuset cgroup_enable=memory cgroup_memory=1/' /boot/firmware/cmdline.txt
  # Disable Swap (Mandatory for Kubernetes)
  - sed -i '/ swap / s/^\(.*\)$/#\1/g' /etc/fstab
  - swapoff -a
  # Disable unnecessary services to save resources
  - systemctl disable --now wpa_supplicant
  - systemctl disable --now atd
  # Apply sysctl settings immediately
  - sysctl --system
  # Note: A reboot is required to apply the cmdline.txt changes
